# Clime / ForecastGuard — Environment Configuration
# The application runs fully functional out-of-the-box with calibrated demonstration
# datasets and public Open-Meteo telemetry; no secret API keys are required.

# Optional: Disable local static file serving if hosted behind a separate CDN (0 = enabled, 1 = disabled)
CLIME_DISABLE_STATIC=0

# Statistical bust threshold percentile (75, 90, or 95)
CLIME_BUST_PERCENTILE=90

# Risk classification thresholds for bust probability
CLIME_MODERATE_BUST_RISK_MIN=0.35
CLIME_HIGH_BUST_RISK_MIN=0.65
